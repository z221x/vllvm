@@ -990,6 +991,22 @@ void EmitAssemblyHelper::RunOptimizationPipeline(
   }
   for (const auto &PassCallback : CodeGenOpts.PassBuilderCallbacks)
     PassCallback(PB);
+  llvm::vllvm::VLLVMOptions Options;
+  Options.EncryptoStr = CodeGenOpts.VLLVMAll || CodeGenOpts.VLLVMEncryptoStr;
+  Options.FlattenFunc = CodeGenOpts.VLLVMAll || CodeGenOpts.VLLVMFlattenFunc;
