+  Options.LocalVarStruct =
+      CodeGenOpts.VLLVMAll || CodeGenOpts.VLLVMLocalVarStruct;
+  PB.registerPipelineStartEPCallback(
+      [Options](ModulePassManager &MPM, OptimizationLevel) {
+        llvm::vllvm::addVLLVMPasses(MPM, Options);
+      });
