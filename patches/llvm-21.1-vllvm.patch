diff --git a/clang/include/clang/Basic/CodeGenOptions.def b/clang/include/clang/Basic/CodeGenOptions.def
index 41031026c..834d15d2c 100644
--- a/clang/include/clang/Basic/CodeGenOptions.def
+++ b/clang/include/clang/Basic/CodeGenOptions.def
@@ -69,6 +69,12 @@ CODEGENOPT(ExperimentalStrictFloatingPoint, 1, 0, Benign) ///< Enables the new,
 CODEGENOPT(EnableNoundefAttrs, 1, 0, Benign) ///< Enable emitting `noundef` attributes on IR call arguments and return values
 CODEGENOPT(DebugPassManager, 1, 0, Benign) ///< Prints debug information for the new
                                            ///< pass manager.
+CODEGENOPT(VLLVMAll, 1, 0, Benign) ///< Enable every VLLVM obfuscation pass.
+CODEGENOPT(VLLVMEncryptoStr, 1, 0, Benign) ///< Enable VLLVM string encryption.
+CODEGENOPT(VLLVMFlattenFunc, 1, 0, Benign) ///< Enable VLLVM control-flow flattening.
+CODEGENOPT(VLLVMIndirectCall, 1, 0, Benign) ///< Enable VLLVM indirect calls.
+CODEGENOPT(VLLVMIndirectBranch, 1, 0, Benign) ///< Enable VLLVM indirect branches.
+CODEGENOPT(VLLVMLocalVarStruct, 1, 0, Benign) ///< Enable VLLVM local variable struct packing.
 CODEGENOPT(DisableRedZone    , 1, 0, Benign) ///< Set when -mno-red-zone is enabled.
 CODEGENOPT(EmitCallSiteInfo, 1, 0, Benign) ///< Emit call site info only in the case of
                                            ///< '-g' + 'O>0' level.
diff --git a/clang/include/clang/Driver/Options.td b/clang/include/clang/Driver/Options.td
index 958d0d05a..d15309ab6 100644
--- a/clang/include/clang/Driver/Options.td
+++ b/clang/include/clang/Driver/Options.td
@@ -1112,6 +1112,30 @@ def cl_ext_EQ : CommaJoined<["-"], "cl-ext=">, Group<opencl_Group>,
 def client__name : JoinedOrSeparate<["-"], "client_name">;
 def combine : Flag<["-", "--"], "combine">, Flags<[NoXarchOption, Unsupported]>;
 def compatibility__version : JoinedOrSeparate<["-"], "compatibility_version">;
+def enstr : Flag<["-"], "enstr">,
+  Flags<[NoXarchOption]>, Visibility<[ClangOption, CC1Option]>,
+  HelpText<"Enable VLLVM string encryption obfuscation">,
+  MarshallingInfoFlag<CodeGenOpts<"VLLVMEncryptoStr">>;
+def fla : Flag<["-"], "fla">,
+  Flags<[NoXarchOption]>, Visibility<[ClangOption, CC1Option]>,
+  HelpText<"Enable VLLVM control-flow flattening obfuscation">,
+  MarshallingInfoFlag<CodeGenOpts<"VLLVMFlattenFunc">>;
+def icall : Flag<["-"], "icall">,
+  Flags<[NoXarchOption]>, Visibility<[ClangOption, CC1Option]>,
+  HelpText<"Enable VLLVM indirect call obfuscation">,
+  MarshallingInfoFlag<CodeGenOpts<"VLLVMIndirectCall">>;
+def ibr : Flag<["-"], "ibr">,
+  Flags<[NoXarchOption]>, Visibility<[ClangOption, CC1Option]>,
+  HelpText<"Enable VLLVM indirect branch obfuscation">,
+  MarshallingInfoFlag<CodeGenOpts<"VLLVMIndirectBranch">>;
+def lvars : Flag<["-"], "lvars">,
+  Flags<[NoXarchOption]>, Visibility<[ClangOption, CC1Option]>,
+  HelpText<"Enable VLLVM local variable struct obfuscation">,
+  MarshallingInfoFlag<CodeGenOpts<"VLLVMLocalVarStruct">>;
+def ollvm : Flag<["-"], "ollvm">,
+  Flags<[NoXarchOption]>, Visibility<[ClangOption, CC1Option]>,
+  HelpText<"Enable all VLLVM obfuscation passes">,
+  MarshallingInfoFlag<CodeGenOpts<"VLLVMAll">>;
 def config : Joined<["--"], "config=">, Flags<[NoXarchOption]>,
   Visibility<[ClangOption, CLOption, DXCOption, FlangOption]>, MetaVarName<"<file>">,
   HelpText<"Specify configuration file">;
